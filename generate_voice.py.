
import os
from pathlib import Path
from openai import OpenAI

client = OpenAI(api_key=os.environ["OPENAI_API_KEY"])

text = """
Dzień dobry. Jest wtorek, trzeci listopada.
Witamy w podcaście Świat w 20 minut.

Dziś przyjrzymy się wydarzeniom, które
mają największe znaczenie dla światowej
polityki, gospodarki i biznesu.

Nie tylko przedstawimy fakty,
ale również wyjaśnimy ich konsekwencje.
Zaczynamy.
"""

with client.audio.speech.with_streaming_response.create(
    model="gpt-4o-mini-tts",
    voice="cedar",
    input=text,
    instructions=(
        "Speak in natural, fluent Polish. "
        "Use a confident, energetic male news-presenter style. "
        "Vary intonation naturally, emphasize important facts, "
        "and use short pauses between topics. "
        "Sound like a professional radio journalist, "
        "not a robotic narrator. Avoid exaggeration."
    ),
) as response:
    response.stream_to_file(Path("probka_glosu.mp3"))

print("Gotowe: probka_glosu.mp3")
